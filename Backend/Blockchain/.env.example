# Network Configuration
# Sepolia Testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-alchemy-api-key
SEPOLIA_PRIVATE_KEY=your_wallet_private_key

# Goerli Testnet (backup)
GOERLI_RPC_URL=https://eth-goerli.g.alchemy.com/v2/your-alchemy-api-key
GOERLI_PRIVATE_KEY=your_wallet_private_key

# Ethereum Mainnet
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-alchemy-api-key
MAINNET_PRIVATE_KEY=your_wallet_private_key

# Polygon Networks
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/your-alchemy-api-key
POLYGON_PRIVATE_KEY=your_wallet_private_key
MUMBAI_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/your-alchemy-api-key
MUMBAI_PRIVATE_KEY=your_wallet_private_key

# API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Gas Reporting
REPORT_GAS=true

# Deployment Configuration
DEPLOY_VERIFY_CONTRACTS=true
DEPLOY_CREATE_DEFAULT_ELECTION=true
DEFAULT_ELECTION_NAME=General Election
DEFAULT_CANDIDATE_COUNT=2

# Contract Addresses (populated after deployment)
VOTING_CONTRACT_ADDRESS_LOCAL=
VOTING_CONTRACT_ADDRESS_SEPOLIA=
VOTING_CONTRACT_ADDRESS_MAINNET=
ELECTION_FACTORY_ADDRESS_LOCAL=
ELECTION_FACTORY_ADDRESS_SEPOLIA=
ELECTION_FACTORY_ADDRESS_MAINNET=